<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{% block title %}Welcome!{% endblock %}</title>

    <link rel="icon"
          href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

    {# ✅ Bootstrap 5 CSS #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: url("https://placehold.co/100x100/FFFFFF/EFEFEF/png?text=53734");
            background-repeat: repeat;
            min-height: 100vh;
        }
    </style>

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body class="d-flex flex-column min-vh-100">
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container">
        <a class="navbar-brand" href="#">My Symfony App</a>

        {# 🔹 Navbar toggler for mobile #}
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_location_index') }}">Location</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_text_input') }}">Formular</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_external_a_p_i') }}">Formular API</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_measurement_index') }}">Measurement</a>
                </li>

                {# 🔹 Login / Logout link depending on user role #}
                <li class="nav-item">
                    {% if is_granted('ROLE_USER') %}
                        <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
                    {% else %}
                        <a class="nav-link" href="{{ path('app_login') }}">Login</a>
                    {% endif %}
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container flex-fill">
    {% block body %}{% endblock %}
</main>

<footer class="bg-light text-center py-3 mt-auto">
    <small>© {{ "now"|date("Y") }} My Symfony App</small>
</footer>

{# ✅ Bootstrap 5 JS Bundle (with Popper) #}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
